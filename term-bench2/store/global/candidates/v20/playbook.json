    },
    {
      "id": "b2",
      "text": "Read the task requirements carefully",
      "helpful": 0,
      "harmful": 0,
      "addedBy": "v0",
      "status": "active",
      "createdAt": "2026-07-16T12:36:11.488278+00:00",
      "updatedAt": "2026-07-16T12:36:11.488278+00:00"
    },
    {
      "id": "b3",
      "text": "Check relevant existing files before writing new ones",
      "helpful": 5,
      "harmful": 0,
      "addedBy": "v0",
      "status": "active",
      "createdAt": "2026-07-16T12:36:11.488278+00:00",
      "updatedAt": "2026-08-12T04:37:04.504Z"
    },
    {
      "id": "b4",
      "text": "Prefer editing existing files over creating new ones",
      "helpful": 0,
      "harmful": 0,
      "addedBy": "v0",
      "status": "active",
      "createdAt": "2026-07-16T12:36:11.488278+00:00",
      "updatedAt": "2026-07-16T12:36:11.488278+00:00"
    },
    {
      "id": "b5",
      "text": "Run tests or type-checks after making changes to verify correctness",
      "helpful": 0,
      "harmful": 6,
      "addedBy": "v0",
      "status": "pruned",
      "createdAt": "2026-07-16T12:36:11.488278+00:00",
      "updatedAt": "2026-08-12T04:37:42.588Z"
    },
    {
      "id": "b6",
      "text": "Do not leave debug code, TODOs, or placeholder comments in the output",
      "helpful": 0,
      "harmful": 0,
      "addedBy": "v0",
      "status": "active",
      "createdAt": "2026-07-16T12:36:11.488278+00:00",
      "updatedAt": "2026-07-16T12:36:11.488278+00:00"
    },
    {
      "id": "b7",
      "text": "When you are about to report a count, size, or state, run one command scoped to exactly that question and read the answer from its output, instead of inferring it from a sample, a listing, or an aggregated result.",
      "helpful": 0,
      "harmful": 0,
      "addedBy": "candidate",
      "status": "active",
      "createdAt": "2026-08-12T04:37:42.588Z",
      "updatedAt": "2026-08-12T04:37:42.588Z",
      "generality": "universal"
    },
    {
      "id": "b8",
      "text": "Do not abandon a lead that measurably matches the target data because it looks complex or slow, until you have implemented it and measured the result.",
      "helpful": 0,
      "harmful": 0,
      "addedBy": "candidate",
      "status": "active",
      "createdAt": "2026-08-12T04:37:42.588Z",
      "updatedAt": "2026-08-12T04:37:42.588Z",
      "generality": "universal"
    }
