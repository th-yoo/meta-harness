    },
    {
      "id": "b2",
      "text": "Read the task requirements carefully",
      "helpful": 0,
      "harmful": 1,
      "addedBy": "v0",
      "status": "active",
      "createdAt": "2026-07-16T12:36:11.488278+00:00",
      "updatedAt": "2026-07-17T23:14:19.727Z"
    },
    {
      "id": "b3",
      "text": "Check relevant existing files before writing new ones",
      "helpful": 0,
      "harmful": 0,
      "addedBy": "v0",
      "status": "active",
      "createdAt": "2026-07-16T12:36:11.488278+00:00",
      "updatedAt": "2026-07-16T12:36:11.488278+00:00"
    },
    {
      "id": "b4",
      "text": "Prefer editing existing files over creating new ones",
      "helpful": 0,
      "harmful": 0,
      "addedBy": "v0",
      "status": "active",
      "createdAt": "2026-07-16T12:36:11.488278+00:00",
      "updatedAt": "2026-07-16T12:36:11.488278+00:00"
    },
    {
      "id": "b5",
      "text": "Run tests or type-checks after making changes to verify correctness",
      "helpful": 0,
      "harmful": 0,
      "addedBy": "v0",
      "status": "active",
      "createdAt": "2026-07-16T12:36:11.488278+00:00",
      "updatedAt": "2026-07-16T12:36:11.488278+00:00"
    },
    {
      "id": "b6",
      "text": "Do not leave debug code, TODOs, or placeholder comments in the output",
      "helpful": 0,
      "harmful": 0,
      "addedBy": "v0",
      "status": "active",
      "createdAt": "2026-07-16T12:36:11.488278+00:00",
      "updatedAt": "2026-07-16T12:36:11.488278+00:00"
    },
    {
      "id": "b7",
      "text": "When the exact output format, filenames, field values, or literal strings are not fully specified, derive them from the task text and provided inputs rather than inventing them; never guess a value the grader will check.",
      "helpful": 0,
      "harmful": 0,
      "addedBy": "candidate",
      "status": "active",
      "createdAt": "2026-07-17T23:14:19.728Z",
      "updatedAt": "2026-07-17T23:14:19.728Z",
      "generality": "universal"
    },
    {
      "id": "b8",
      "text": "Verify against the task's stated success criteria or independent ground truth, not against your own assumptions—self-checks that only confirm your invented format prove nothing.",
      "helpful": 0,
      "harmful": 0,
      "addedBy": "candidate",
      "status": "active",
      "createdAt": "2026-07-17T23:14:19.728Z",
      "updatedAt": "2026-07-17T23:14:19.728Z",
      "generality": "universal"
    }
  ]
