# term-bench2/Containerfile — the bench sandbox image (built by `cmd-prep` in
# the P3 exec funnel; see opencode-plugin/src/bench/sandbox.ts for the podman
# argv builders that consume this).
#
# This replaces the old Python runner's bwrap sandbox (a fresh tmpfs root
# bind-mounted over the host's /usr, /etc, ~/bench, ...) with a real,
# throwaway container per task attempt: podman create/start once, then
# `podman exec` per step (setup -> agent -> verifier) against this image,
# then `podman rm -f -t 0`. Containers run as root, with real sudo/apt-get
# and real network — podman containers have genuine root + network, unlike
# bwrap's unprivileged sandbox, so apt-get genuinely works inside them.
#
# Per-task apt (Option A, 2026-07-11): each task's OWN apt packages are
# installed at STAGING time, not baked into this shared image — see
# opencode-plugin/src/bench/staging.ts's aptPackages step (runtime staging
# mode) and term-bench2/gen_setup_deps.py's SKIP_APT-guarded apt section
# (scripts mode; the runner no longer sets SKIP_APT=1, so that guarded
# section now actually executes). This retires the old bwrap-era emulation
# where SKIP_APT=1 was required because apt-get was a no-op shim.
#
# Root cause this fixes: the apt union below used to ALSO include
# Python-library carrier packages (python3-opencv, mailman3). Debian's
# python3-opencv pulls in a Debian-packaged numpy (1.26.4 at the time of
# writing) into the system site-packages — which then SHADOWS a task's own
# `pip install numpy==<newer>` inside the container ("Cannot uninstall ...
# it is a distutils installed project" / "installed by debian"), because pip
# refuses to remove a dpkg-owned file. mailman3 is the same shape of hazard
# (also carries its own Python deps into system site-packages). This broke
# 5 of 43 oracle tasks. The fix: this shared image now carries ONLY the
# non-Python toolchain (compilers, network tools, docs/OCR/etc. binaries)
# plus the bare Python INTERPRETER packages below (python3, python3-pip,
# python3-venv, python-is-python3 — these four ship no library payload, so
# they cannot shadow anything a task pip-installs). Any package that drags
# in Python *libraries* via apt (python3-<anything-but-pip/venv>, and by
# extension anything like mailman3 that transitively pulls one in) must
# NEVER be added back to this union — such deps belong in the task's own
# Dockerfile, installed at staging time (podman gives every task attempt a
# fresh container, so a per-task apt install cannot cross-contaminate
# another task's run).
#
# The apt package list below (minus the two removed Python-library carriers
# above) is the union of term-bench2/apt-packages.txt and the EXTRA_APT list
# in runner.py (~line 190), plus a few packages the podman design needs that
# the bwrap sandbox got for free from the host: sudo (bwrap ran unprivileged
# and shimmed sudo/apt-get as no-ops; here sudo is real), python-is-python3
# (TB2 tasks assume a bare `python`; bwrap's ~/bench/bin shim provided this —
# here it's a real system symlink), ca-certificates, curl, wget, git (used to
# fetch uv below and by tasks that clone/fetch).
#
# opencode itself is baked into this image (below) rather than bind-mounted
# from the host at container-run time: the host running this build (macOS/
# darwin, per the P6 task brief) cannot supply a linux binary onto a linux
# container. Credential mounts (~/.claude, ~/.local/share/opencode) ARE still
# host bind-mounts, added at container-create time by cmd-run.ts — those are
# plain data directories (JSON/auth files), not architecture-specific.
#
# Claude Code CLI is also baked into this image (below), pinned to a specific
# version. The B5 claude-code AgentDriver execs `claude -p` INSIDE the
# container; the stream-json schema drifts across versions and the parser is
# written against this pinned version only.
#
# Provenance note: env_block's `opencodeVersion` field (record.ts) records
# the version by running `opencode --version` INSIDE the container via one
# `podman exec` per run — never the host's `opencode --version` — since the
# host and container binaries are two different installs (and, per the
# above, may not even be the same architecture). Similarly, per-driver
# in-container version detection (not the image tag) is used by B5's driver.
FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_BREAK_SYSTEM_PACKAGES=1

RUN apt-get update && apt-get install -y \
    apache2-utils \
    asciinema \
    bc \
    binutils \
    build-essential \
    ca-certificates \
    coq \
    curl \
    e2fsprogs \
    expect \
    extundelete \
    ffmpeg \
    foremost \
    fossil \
    g++ \
    gcc \
    git \
    less \
    libgl1 \
    libglib2.0-0t64 \
    libgomp1 \
    libjpeg-dev \
    libsm6 \
    libtesseract-dev \
    libxext6 \
    libxrender-dev \
    mailutils \
    make \
    nano \
    net-tools \
    nginx \
    nodejs \
    npm \
    openssh-server \
    openssl \
    postfix \
    primer3 \
    python-is-python3 \
    python3 \
    python3-pip \
    python3-venv \
    r-base \
    rustc \
    screen \
    sleuthkit \
    sqlite3 \
    sudo \
    tclsh \
    tesseract-ocr \
    texlive-latex-base \
    tmux \
    unzip \
    vim \
    wget \
    xxd \
    zip \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# uv, for test.sh's uvx/pytest self-bootstrap (each container's cache warms
# per-run; network stays enabled for exactly this — see sandbox.ts header).
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# uv-managed CPythons for the python-version shim (staging.ts): tasks whose
# base image pins python:3.10/3.11/3.13 get bare python3/pip3 shimmed onto
# the matching interpreter instead of the system 3.12 — C extensions then
# build against the same interpreter the task's `uvx -p X.Y` tests import
# them with (portfolio-optimization), and apt Debian python libs stay
# invisible to the task python (gcode-to-text). Pre-baked here so staging
# pays no per-attempt download.
RUN uv python install 3.10 3.11 3.13

# Read by every non-interactive bash (solve.sh, test.sh, staging steps,
# agent-spawned shells). The file is only created by staging.ts's
# python-version shim — it exports the shimmed interpreter's bin dir onto
# PATH so pip-installed console scripts (pytest, twine, ...) are callable
# bare. Absent file = silent no-op for unshimmed tasks.
ENV BASH_ENV=/etc/mh-shim-env

# opencode itself — the P6 agent phase (record.ts/cmd-run.ts) execs this
# INSIDE the container (`podman exec ... opencode run --dir /app ...`), never
# on the host. The installer (https://opencode.ai/install) unpacks to
# ~/.opencode/bin and tries to add that to PATH by appending an export line
# to a shell rc file (~/.bashrc etc) — which `podman exec` never sources (it
# execs argv directly, no login/interactive shell), so that alone would leave
# `opencode` unresolvable. The explicit ENV PATH below is what actually makes
# it resolvable for `podman exec`.
RUN curl -fsSL https://opencode.ai/install | bash
ENV PATH="/root/.opencode/bin:${PATH}"

# Claude Code — the claude-code AgentDriver execs `claude -p` INSIDE the
# container. Pinned exactly: the stream-json output schema drifts across
# versions and drivers/claude-code.ts's parser is written against this one.
RUN npm install -g @anthropic-ai/claude-code@2.1.207

# Buildah records WORKDIR in image config but does not materialize the
# directory as a filesystem layer — and `podman create -w /app` makes `start`
# refuse when it's missing. Create the standard task dirs explicitly.
RUN mkdir -p /app /tests /logs/verifier

WORKDIR /app
