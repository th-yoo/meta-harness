{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/opencode-plugin/src/adapters/claude-code/hook-cli.ts SessionStart",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/opencode-plugin/src/adapters/claude-code/hook-cli.ts UserPromptSubmit",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/opencode-plugin/src/adapters/claude-code/hook-cli.ts PreToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/opencode-plugin/src/adapters/claude-code/hook-cli.ts PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun ${CLAUDE_PROJECT_DIR}/opencode-plugin/src/adapters/claude-code/hook-cli.ts Stop",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "env": {
    "MH_ROLE": "mh-build"
  }
}
